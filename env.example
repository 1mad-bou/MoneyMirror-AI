# ==========================================
# Environment Configuration
# ==========================================
ENV=development

# ==========================================
# Database (PostgreSQL with pgvector)
# ==========================================
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname
POSTGRES_PORT=5454
DATABASE_URI=postgresql://user:password@postgres:5432/dbname
DATABASE_URL=postgresql://user:password@postgres:5432/dbname

# ==========================================
# Backend API & Security
# ==========================================
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ==========================================
# Financial Defaults
# ==========================================
DEFAULT_CURRENCY=MAD

# ==========================================
# Google AI Studio / Gemma
# ==========================================
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMMA_MODEL=gemma-3-27b-it
GEMMA_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_SECONDS=45

# ==========================================
# Receipt Scanning / OCR
# ==========================================
OCR_ENABLED=true
OCR_LANG=en
RECEIPT_MAX_BYTES=8388608
RECEIPT_TMP_DIR=/app/storage/receipts

# ==========================================
# RAG Embeddings (Local FastEmbed)
# ==========================================
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=/app/models/fastembed
BACKGROUND_JOBS_ENABLED=true

# ==========================================
# Frontend (Next.js)
# ==========================================
FRONTEND_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8000
